import { useEffect } from 'react';
import usePhotoStore from './store/usePhotoStore';
import Toolbar from './components/Toolbar';
import PhotoGrid from './components/PhotoGrid';
import StatusBar from './components/StatusBar';
import { isFileSystemAccessSupported } from './utils/fileSystem';

function App() {
  const selectedPhotoId = usePhotoStore((state) => state.selectedPhotoId);
  const setCategory = usePhotoStore((state) => state.setCategory);
  const photos = usePhotoStore((state) => state.photos);
  const setSelectedPhotoId = usePhotoStore((state) => state.setSelectedPhotoId);

  // 键盘快捷键
  useEffect(() => {
    const handleKeyDown = (e) => {
      // 如果没有选中的图片,使用第一张
      let targetPhotoId = selectedPhotoId;
      if (!targetPhotoId && photos.length > 0) {
        targetPhotoId = photos[0].id;
        setSelectedPhotoId(targetPhotoId);
      }

      if (!targetPhotoId) return;

      // 分类快捷键
      if (e.key === '1') {
        e.preventDefault();
        setCategory(targetPhotoId, 'correct');
        moveToNextPhoto();
      } else if (e.key === '2') {
        e.preventDefault();
        setCategory(targetPhotoId, 'medium');
        moveToNextPhoto();
      } else if (e.key === '3') {
        e.preventDefault();
        setCategory(targetPhotoId, 'wrong');
        moveToNextPhoto();
      } else if (e.key === '0') {
        e.preventDefault();
        setCategory(targetPhotoId, null);
      }
      // 导航快捷键
      else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        moveToPrevPhoto();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        moveToNextPhoto();
      }
    };

    const moveToNextPhoto = () => {
      if (!selectedPhotoId || photos.length === 0) return;

      const currentIndex = photos.findIndex(p => p.id === selectedPhotoId);
      if (currentIndex < photos.length - 1) {
        setSelectedPhotoId(photos[currentIndex + 1].id);
      }
    };

    const moveToPrevPhoto = () => {
      if (!selectedPhotoId || photos.length === 0) return;

      const currentIndex = photos.findIndex(p => p.id === selectedPhotoId);
      if (currentIndex > 0) {
        setSelectedPhotoId(photos[currentIndex - 1].id);
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [selectedPhotoId, photos, setCategory, setSelectedPhotoId]);

  // 检查浏览器兼容性
  useEffect(() => {
    if (!isFileSystemAccessSupported()) {
      const message =
        '⚠️ 浏览器兼容性提示\n\n' +
        'PhotoPicker 使用了 File System Access API,\n' +
        '目前仅支持 Chrome 和 Edge 浏览器。\n\n' +
        '请使用以下浏览器获得最佳体验:\n' +
        '· Chrome 86+\n' +
        '· Edge 86+\n\n' +
        'Firefox 和 Safari 暂不支持。';

      alert(message);
    }
  }, []);

  return (
    <div className="h-screen flex flex-col bg-gray-50">
      <Toolbar />
      <PhotoGrid />
      <StatusBar />
    </div>
  );
}

export default App;
